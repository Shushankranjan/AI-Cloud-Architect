# Copy to .env and fill in. .env is gitignored.

# stub = serve contract fixtures (no LLM). live = call the configured LLM provider.
ARCHITECT_MODE=stub

# LLM provider: openrouter (recommended; works with any hosted model) or gemini.
ARCHITECT_LLM_PROVIDER=openrouter

# Required when provider=openrouter and ARCHITECT_MODE=live.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required when provider=gemini and ARCHITECT_MODE=live.
GEMINI_API_KEY=

# Model used for all generation steps. The provider prefix matters:
#   - openrouter: use the OpenRouter model id, e.g. google/gemini-2.5-flash,
#                 meta-llama/llama-3.3-70b-instruct:free, qwen/qwen-2.5-72b-instruct:free
#   - gemini:     use the Gemini model name, e.g. gemini-2.5-flash
# Pick a model that supports JSON mode (OpenRouter's response_format: json_object).
ARCHITECT_LARGE_MODEL=google/gemini-2.5-flash

# LLM call timeout (seconds) and max self-heal retries on schema/mermaid validation failure
ARCHITECT_LLM_TIMEOUT=120
ARCHITECT_LLM_MAX_RETRIES=2
