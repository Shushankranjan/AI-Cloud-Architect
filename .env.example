# Copy to .env and fill in. .env is gitignored.

# stub = serve contract fixtures (no LLM). live = call the configured LLM provider.
ARCHITECT_MODE=stub

# LLM provider: gemini (Phase 1). ollama support is planned behind the same interface.
ARCHITECT_LLM_PROVIDER=gemini

# Required when ARCHITECT_MODE=live
GEMINI_API_KEY=

# Model used for all generation steps (Phase 1: single model, no fallback).
# Pinned flash models (e.g. gemini-3.6-flash) are free-tier friendly and far less
# likely to hit 503 "high demand" than the *-latest aliases (which route to the
# newest, most-overloaded model). Verify availability with the /v1beta/models API.
# Pro models (gemini-pro-latest) require billing enabled.
ARCHITECT_LARGE_MODEL=gemini-3.6-flash

# LLM call timeout (seconds) and max self-heal retries on schema/mermaid validation failure
ARCHITECT_LLM_TIMEOUT=120
ARCHITECT_LLM_MAX_RETRIES=2
